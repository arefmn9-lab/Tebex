{
  "id": "bale.forward_channel_message.linear.v1",
  "platform": "bale",
  "operation": "forward_channel_messages",
  "required_context": [
    "sender_account_id",
    "source_url",
    "source_uid",
    "recipient_phone",
    "recipient_display_name",
    "operation_mode",
    "allow_final_send"
  ],
  "elements": {
    "source_message_items": {
      "selector": "[aria-label=\"message-item\"]",
      "timeout_ms": 7000
    },
    "message_forward_control": {
      "selector": "[data-testid=\"message-side-option-forward\"]",
      "timeout_ms": 3000
    },
    "recipient_search_input": {
      "selector": ".ReactModal__Overlay input[placeholder=\"\u062c\u0633\u062a\u062c\u0648\u06cc \u0645\u062e\u0627\u0637\u0628\u060c \u06af\u0631\u0648\u0647\u060c \u06a9\u0627\u0646\u0627\u0644 \u0648 \u0646\u0627\u0645\u200c\u06a9\u0627\u0631\u0628\u0631\u06cc...\"]",
      "timeout_ms": 4000
    },
    "recipient_result_rows": {
      "selector": ".ReactModal__Overlay .qHFpb6",
      "timeout_ms": 4000
    },
    "final_forward_button": {
      "selector": ".ReactModal__Overlay [role=\"button\"][aria-label=\"send-button-forward-messages\"][data-testid=\"bold-send2-icon\"]",
      "timeout_ms": 4000,
      "destructive": true
    }
  },
  "steps": [
    {
      "id": "validate_context",
      "action": "call_platform_primitive",
      "name": "validate_operation_mode",
      "params": {
        "operation_mode": "{{operation_mode}}",
        "allow_final_send": "{{allow_final_send}}"
      }
    },
    {
      "id": "open_source",
      "action": "navigate",
      "url": "{{source_url}}",
      "timeout_ms": 10000
    },
    {
      "id": "wait_source_message",
      "action": "wait_for",
      "element": "source_message_items",
      "timeout_ms": 7000
    },
    {
      "id": "inspect_only_stop",
      "action": "stop",
      "when": "context.operation_mode == 'inspect_only'",
      "stopped_before_send": true,
      "reason": "inspect_only_complete"
    },
    {
      "id": "select_latest_message",
      "action": "call_platform_primitive",
      "name": "select_latest_message",
      "params": {}
    },
    {
      "id": "hover_latest_message",
      "action": "call_platform_primitive",
      "name": "hover_latest_message",
      "params": {}
    },
    {
      "id": "open_forward_picker",
      "action": "click",
      "element": "message_forward_control",
      "timeout_ms": 3000
    },
    {
      "id": "wait_recipient_search",
      "action": "wait_for",
      "element": "recipient_search_input",
      "timeout_ms": 4000
    },
    {
      "id": "type_recipient_name",
      "action": "fill",
      "element": "recipient_search_input",
      "value": "{{recipient_display_name}}",
      "timeout_ms": 4000
    },
    {
      "id": "wait_recipient_results",
      "action": "wait_for",
      "element": "recipient_result_rows",
      "timeout_ms": 4000
    },
    {
      "id": "select_first_recipient_result",
      "action": "choose_from_list",
      "element": "recipient_result_rows",
      "exact_text": "{{recipient_display_name}}",
      "timeout_ms": 4000
    },
    {
      "id": "selection_only_stop",
      "action": "stop",
      "when": "context.operation_mode == 'selection_only'",
      "stopped_before_send": true,
      "reason": "selection_only_complete"
    },
    {
      "id": "wait_final_confirmation",
      "action": "wait_for",
      "element": "final_forward_button",
      "timeout_ms": 4000
    },
    {
      "id": "no_send_stop",
      "action": "stop",
      "when": "context.operation_mode == 'no_send'",
      "stopped_before_send": true,
      "reason": "no_send_boundary_reached"
    },
    {
      "id": "authorize_live_send",
      "action": "stop",
      "when": "context.operation_mode == 'live_send' AND context.allow_final_send != true",
      "ok": false,
      "error_code": "final_send_not_authorized",
      "stopped_before_send": true,
      "reason": "final_send_not_authorized"
    },
    {
      "id": "click_final_forward_once",
      "action": "click",
      "when": "context.operation_mode == 'live_send' AND context.allow_final_send == true",
      "element": "final_forward_button",
      "timeout_ms": 4000
    },
    {
      "id": "complete",
      "action": "record_result",
      "when": "context.operation_mode == 'live_send' AND context.allow_final_send == true",
      "name": "final_send_invoked",
      "value": true
    }
  ]
}
